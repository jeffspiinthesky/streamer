[Unit]
Description=YouTube live -> UDP relay (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
ExecStart=/usr/local/bin/youtube-udp-streamer %i
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
